# Udev rule for EZP series USB flash programmers
# (EZP2019, EZP2019+, EZP2020, EZP2023, EZP2023+)
#
# Place this file in /etc/udev/rules.d/99-ezp2023.rules
# Then run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# EZP2019 / EZP2023+ (Standard VID:PID)
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc8", ATTR{idProduct}=="310b", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# EZP2019+
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc8", ATTR{idProduct}=="310c", MODE="0666", GROUP="plugdev", TAG+="uaccess"

# EZP2023
SUBSYSTEM=="usb", ATTR{idVendor}=="1fc8", ATTR{idProduct}=="310d", MODE="0666", GROUP="plugdev", TAG+="uaccess"
