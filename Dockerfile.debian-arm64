FROM debian:bookworm-slim

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        qt6-base-dev \
        qt6-tools-dev \
        qt6-tools-dev-tools \
        qt6-l10n-tools \
        libusb-1.0-0-dev \
        libftdi1-dev \
        dpkg-dev \
        binutils \
        file && \
    rm -rf /var/lib/apt/lists/*
